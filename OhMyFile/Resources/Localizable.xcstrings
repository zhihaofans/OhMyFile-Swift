    "%@ · This will also move %ld files inside the folder to Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 会连同文件夹内的 %ld 个文件一起移入回收站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 會一併將資料夾內的 %ld 個檔案移到垃圾桶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · フォルダ内の %ld 個のファイルもゴミ箱に移動します。"
          }
        }
      }
    },
