        {
          "target": "OhMyFileShareExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/OhMyFile.app", "id": "26006047309CD32B00504BC0", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/OhMyFileTests.xctest", "id": "26006054309CD32D00504BC0", "type": "wrapper.cfbundle", "index": false },
