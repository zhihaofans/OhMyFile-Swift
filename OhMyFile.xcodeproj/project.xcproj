      "zh-Hans",
    ],
  },
  "files": [
    { "kind": "folder", "path": "OhMyFile", "target-membership": [ "OhMyFile" ] },
    { "kind": "folder", "path": "OhMyFileTests", "target-membership": [ "OhMyFileTests" ] },
    { "kind": "folder", "path": "OhMyFileUITests", "target-membership": [ "OhMyFileUITests" ] },
    {
      "kind": "folder",
